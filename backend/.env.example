# قاعدة البيانات
DATABASE_URL=postgresql://maqouti:maqouti@localhost:5432/maqouti

# المصادقة (أسرار — لا تُكتب أبداً في Git)
JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d

# جلسة بوابة App Owner (أقصر من جلسات المتجر)
ADMIN_JWT_ACCESS_TOKEN_TTL=10m
ADMIN_JWT_REFRESH_TOKEN_TTL=4h

# كلمة المرور الاحتياطية المؤقتة (R-32)
TEMP_PASSWORD_VALIDITY_HOURS=24

# إجبار تحديث التطبيق
MIN_SUPPORTED_APP_VERSION=1.0.0

# البيئة والتشغيل
APP_ENV=development
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# عدد مستويات الـ Proxy الموثوقة خلف Cloudflare/Caddy (0 في التطوير المحلي)
TRUST_PROXY=0

# CORS — نطاقات مفصولة بفاصلة. مطلوبة في الإنتاج (مثال: https://admin.maqouti.app)
CORS_ORIGINS=http://localhost:3001

# مراقبة الأخطاء (اختياري — يُترك فارغاً للتعطيل)
SENTRY_DSN=

# تخزين الملفات (R2/B2 — S3-compatible)
FILE_STORAGE_PROVIDER=r2
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_REGION=auto
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=

  actorType     ActorType   @map("actor_type")
  actorId       String?     @map("actor_id") @db.Uuid
  actionType    String      @map("action_type") // القائمة الكاملة في 13-authentication-security.md القسم 9
  targetType    String?     @map("target_type")

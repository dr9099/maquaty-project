// ═══════════════════════ طبقة المطابقة اليومية والإغلاق ═══════════════════════

model DailyClosing {
  id           String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId String        @map("store_owner_id") @db.Uuid
  workerId     String?       @map("worker_id") @db.Uuid // NULL يمثل إغلاق المالك نفسه
  closingDate  DateTime      @map("closing_date") @db.Date
  actualCash   Decimal       @map("actual_cash") @db.Decimal(12, 2)
  expectedCash Decimal       @map("expected_cash") @db.Decimal(12, 2) // محسوب: مبيعات نقدية + دفعات آجل نقدية لنفس الحساب واليوم
  difference   Decimal       @db.Decimal(12, 2) // actual_cash - expected_cash (تُحسب في الخدمة عند الحفظ)
  status       ClosingStatus @default(OPEN)
  approvedBy   String?       @map("approved_by") @db.Uuid // يُملأ عند CLOSED
  approvedAt   DateTime?     @map("approved_at")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  storeOwner       StoreOwner        @relation(fields: [storeOwnerId], references: [id])
  sales            Sale[]
  creditPayments   CreditPayment[]
  purchaseInvoices PurchaseInvoice[]
  supplierPayments SupplierPayment[]

  @@unique([storeOwnerId, workerId, closingDate]) // Prisma: يُستكمل بـ NULLS NOT DISTINCT عبر SQL خام في migration (PostgreSQL 15+)
  @@map("daily_closings")
}

// ═══════════════════════ طبقة المحاسبة (Double-Entry) ═══════════════════════

model ChartOfAccount {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId    String      @map("store_owner_id") @db.Uuid
  code            String // 1000، 1100، ... 5600، 4300
  name            String
  accountType     AccountType @map("account_type")
  parentAccountId String?     @map("parent_account_id") @db.Uuid
  createdAt       DateTime    @default(now()) @map("created_at")

  storeOwner    StoreOwner       @relation(fields: [storeOwnerId], references: [id])
  parent        ChartOfAccount?  @relation("AccountHierarchy", fields: [parentAccountId], references: [id])
  children      ChartOfAccount[] @relation("AccountHierarchy")
  ledgerEntries LedgerEntry[]

  @@unique([storeOwnerId, code])
  @@map("chart_of_accounts")
}

model LedgerEntry {
  id            String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId  String              @map("store_owner_id") @db.Uuid
  entryDate     DateTime            @map("entry_date") @db.Date
  referenceType LedgerReferenceType @map("reference_type")
  referenceId   String              @map("reference_id") @db.Uuid
  accountId     String              @map("account_id") @db.Uuid
  debit         Decimal             @default(0) @db.Decimal(12, 2)
  credit        Decimal             @default(0) @db.Decimal(12, 2)
  description   String?
  createdAt     DateTime            @default(now()) @map("created_at") // Append-only (BR-055) — لا تعديل ولا حذف

  storeOwner StoreOwner     @relation(fields: [storeOwnerId], references: [id])
  account    ChartOfAccount @relation(fields: [accountId], references: [id])

  @@index([storeOwnerId, entryDate])
  @@index([referenceType, referenceId])
  @@index([accountId])
  @@map("ledger_entries")
}

model Return {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId String   @map("store_owner_id") @db.Uuid
  saleId       String   @map("sale_id") @db.Uuid
  workerId     String?  @map("worker_id") @db.Uuid
  quantity     Decimal  @db.Decimal(12, 3)
  amount       Decimal  @db.Decimal(12, 2)
  returnedAt   DateTime @default(now()) @map("returned_at")
  createdAt    DateTime @default(now()) @map("created_at")

  storeOwner StoreOwner @relation(fields: [storeOwnerId], references: [id])
  sale       Sale       @relation(fields: [saleId], references: [id])
  worker     Worker?    @relation(fields: [workerId], references: [id])
  item       Item?      @relation(fields: [itemId], references: [id])
  itemId     String?    @map("item_id") @db.Uuid

  @@map("returns")
}

// ═══════════════════════ طبقة الرسائل والإعلانات والعروض ═══════════════════════

model Broadcast {
  id                  String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdBy           String              @map("created_by") @db.Uuid
  type                BroadcastType
  title               String
  body                String
  imageUrl            String?             @map("image_url")
  buttonText          String?             @map("button_text")
  buttonUrl           String?             @map("button_url") // خارجي (واتساب) أو مسار داخلي
  durationHours       Int                 @default(0) @map("duration_hours") // 0 = حتى الإيقاف اليدوي
  expiresAt           DateTime?           @map("expires_at") // يحوَّل من duration_hours لحظة الإنشاء
  dismissible         Boolean             @default(true)
  priority            BroadcastPriority   @default(NORMAL)
  targetType          BroadcastTargetType @map("target_type")
  targetDeviceId      String?             @map("target_device_id") @db.Uuid
  discountCode        String?             @map("discount_code") // يُحفظ Upper-case (BR-061)
  discountPercentText String?             @map("discount_percent_text")
  isActive            Boolean             @default(true) @map("is_active")
  viewsCount          Int                 @default(0) @map("views_count")
  clicksCount         Int                 @default(0) @map("clicks_count")
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  createdByAdmin PlatformAdmin  @relation(fields: [createdBy], references: [id])
  acks           BroadcastAck[]

  @@map("broadcasts")
}

model BroadcastAck {
  id           String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  broadcastId  String           @map("broadcast_id") @db.Uuid
  deviceId     String           @map("device_id") @db.Uuid
  storeOwnerId String?          @map("store_owner_id") @db.Uuid
  ackType      BroadcastAckType @map("ack_type")
  ackedAt      DateTime         @default(now()) @map("acked_at")

  broadcast  Broadcast   @relation(fields: [broadcastId], references: [id])
  device     Device      @relation(fields: [deviceId], references: [id])
  storeOwner StoreOwner? @relation(fields: [storeOwnerId], references: [id])

  @@map("broadcast_acks")
}

// ═══════════════════════ طبقة سجل التدقيق ═══════════════════════

model AuditLog {

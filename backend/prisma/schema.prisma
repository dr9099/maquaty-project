// ═══════════════════════ طبقة المشتريات وإدارة الموردين ═══════════════════════

model Supplier {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId          String         @map("store_owner_id") @db.Uuid
  name                  String
  phone                 String?
  address               String?
  contactPerson         String?        @map("contact_person")
  taxNumber             String?        @map("tax_number")
  notes                 String?
  openingBalance        Decimal        @default(0) @map("opening_balance") @db.Decimal(12, 2)
  openingBalanceSettled Decimal        @default(0) @map("opening_balance_settled") @db.Decimal(12, 2) // لتتبع تسوية الرصيد الافتتاحي وأعمار الديون (FIFO)
  currentBalance        Decimal        @default(0) @map("current_balance") @db.Decimal(12, 2)
  creditLimit           Decimal?       @map("credit_limit") @db.Decimal(12, 2)
  paymentTermsDays      Int?           @map("payment_terms_days")
  status                SupplierStatus @default(ACTIVE)
  deletedAt             DateTime?      @map("deleted_at")
  createdAt             DateTime       @default(now()) @map("created_at")
  updatedAt             DateTime       @updatedAt @map("updated_at")

  storeOwner       StoreOwner        @relation(fields: [storeOwnerId], references: [id])
  purchaseInvoices PurchaseInvoice[]
  payments         SupplierPayment[]
  returns          PurchaseReturn[]

  @@index([storeOwnerId, status])
  @@index([storeOwnerId, name])
  @@map("suppliers")
}

model PurchaseInvoice {
  id                 String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId       String                @map("store_owner_id") @db.Uuid
  workerId           String?               @map("worker_id") @db.Uuid
  supplierId         String                @map("supplier_id") @db.Uuid
  invoiceNumber      String                @map("invoice_number")
  supplierInvoiceRef String?               @map("supplier_invoice_ref")
  invoiceDate        DateTime              @map("invoice_date") @db.Date
  dueDate            DateTime?             @map("due_date") @db.Date
  paymentType        PurchasePaymentType   @map("payment_type")
  walletId           String?               @map("wallet_id") @db.Uuid
  walletSettled      Boolean               @default(false) @map("wallet_settled")
  walletSettlementId String?               @map("wallet_settlement_id") @db.Uuid
  subtotal           Decimal               @db.Decimal(12, 2)
  taxAmount          Decimal               @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount     Decimal               @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalAmount        Decimal               @map("total_amount") @db.Decimal(12, 2)
  paidAmount         Decimal               @default(0) @map("paid_amount") @db.Decimal(12, 2)
  settledAmount      Decimal               @default(0) @map("settled_amount") @db.Decimal(12, 2) // الدفعات اللاحقة + المرتجعات المخصومة من الدين لهذه الفاتورة
  remainingAmount    Decimal               @map("remaining_amount") @db.Decimal(12, 2)
  currency           Currency              @default(YER)
  attachmentUrl      String?               @map("attachment_url")
  notes              String?
  status             PurchaseInvoiceStatus @default(POSTED)
  costingMethodUsed  CostingMethod         @default(WEIGHTED_AVERAGE) @map("costing_method_used")
  dailyClosingId     String?               @map("daily_closing_id") @db.Uuid
  postedAt           DateTime?             @map("posted_at")
  voidedAt           DateTime?             @map("voided_at")
  voidReason         String?               @map("void_reason")
  createdAt          DateTime              @default(now()) @map("created_at")
  updatedAt          DateTime              @updatedAt @map("updated_at")

  storeOwner       StoreOwner        @relation(fields: [storeOwnerId], references: [id])
  worker           Worker?           @relation(fields: [workerId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  wallet           Wallet?           @relation(fields: [walletId], references: [id])
  walletSettlement WalletSettlement? @relation(fields: [walletSettlementId], references: [id])
  dailyClosing     DailyClosing?     @relation(fields: [dailyClosingId], references: [id])
  items            PurchaseItem[]
  payments         SupplierPayment[]
  returns          PurchaseReturn[]

  @@unique([storeOwnerId, invoiceNumber])
  @@index([storeOwnerId, invoiceDate])
  @@index([storeOwnerId, supplierId, status])
  @@index([dailyClosingId])
  @@index([walletId, walletSettled])
  @@map("purchase_invoices")
}

model PurchaseItem {
  id                        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId              String              @map("store_owner_id") @db.Uuid
  purchaseInvoiceId         String              @map("purchase_invoice_id") @db.Uuid
  itemId                    String?             @map("item_id") @db.Uuid // يُربط بالصنف عند ترحيل الفاتورة (POSTED)
  itemName                  String              @map("item_name")
  baseUnit                  String              @map("base_unit")
  unit                      String
  conversionFactor          Decimal             @default(1) @map("conversion_factor") @db.Decimal(12, 3)
  quantity                  Decimal             @db.Decimal(12, 3)
  baseQuantity              Decimal             @map("base_quantity") @db.Decimal(12, 3)
  unitCostPrice             Decimal             @map("unit_cost_price") @db.Decimal(12, 2)
  taxAmount                 Decimal             @default(0) @map("tax_amount") @db.Decimal(12, 2)
  discountAmount            Decimal             @default(0) @map("discount_amount") @db.Decimal(12, 2)
  totalLineCost             Decimal             @map("total_line_cost") @db.Decimal(12, 2)
  effectiveBaseUnitCost     Decimal             @map("effective_base_unit_cost") @db.Decimal(12, 2)
  sellPrice                 Decimal             @map("sell_price") @db.Decimal(12, 2)
  emergencyPriceMode        EmergencyPriceMode? @map("emergency_price_mode")
  emergencyPricePlusFixed   Decimal?            @map("emergency_price_plus_fixed") @db.Decimal(12, 2)
  emergencyPricePlusPercent Decimal?            @map("emergency_price_plus_percent") @db.Decimal(5, 2)
  emergencyPriceMin         Decimal?            @map("emergency_price_min") @db.Decimal(12, 2)
  emergencyPriceMax         Decimal?            @map("emergency_price_max") @db.Decimal(12, 2)
  remainingFifoQty          Decimal             @default(0) @map("remaining_fifo_qty") @db.Decimal(12, 3)
  returnedQuantity          Decimal             @default(0) @map("returned_quantity") @db.Decimal(12, 3)
  createdAt                 DateTime            @default(now()) @map("created_at")

  storeOwner      StoreOwner       @relation(fields: [storeOwnerId], references: [id])
  purchaseInvoice PurchaseInvoice  @relation(fields: [purchaseInvoiceId], references: [id], onDelete: Cascade)
  item            Item?            @relation(fields: [itemId], references: [id])
  returns         PurchaseReturn[]

  @@index([purchaseInvoiceId])
  @@index([storeOwnerId, itemId])
  @@map("purchase_items")
}

model SupplierPayment {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId         String      @map("store_owner_id") @db.Uuid
  workerId             String?     @map("worker_id") @db.Uuid
  supplierId           String      @map("supplier_id") @db.Uuid
  purchaseInvoiceId    String?     @map("purchase_invoice_id") @db.Uuid
  amount               Decimal     @db.Decimal(12, 2)
  paymentMethod        PaymentType @map("payment_method")
  walletId             String?     @map("wallet_id") @db.Uuid
  walletSettled        Boolean     @default(false) @map("wallet_settled")
  walletSettlementId   String?     @map("wallet_settlement_id") @db.Uuid
  receiptAttachmentUrl String?     @map("receipt_attachment_url")
  notes                String?
  dailyClosingId       String?     @map("daily_closing_id") @db.Uuid
  paidAt               DateTime    @default(now()) @map("paid_at")
  createdAt            DateTime    @default(now()) @map("created_at")

  storeOwner       StoreOwner        @relation(fields: [storeOwnerId], references: [id])
  worker           Worker?           @relation(fields: [workerId], references: [id])
  supplier         Supplier          @relation(fields: [supplierId], references: [id])
  purchaseInvoice  PurchaseInvoice?  @relation(fields: [purchaseInvoiceId], references: [id])
  wallet           Wallet?           @relation(fields: [walletId], references: [id])
  walletSettlement WalletSettlement? @relation(fields: [walletSettlementId], references: [id])
  dailyClosing     DailyClosing?     @relation(fields: [dailyClosingId], references: [id])

  @@index([storeOwnerId, supplierId, paidAt])
  @@index([dailyClosingId])
  @@index([walletId, walletSettled])
  @@map("supplier_payments")
}

model PurchaseReturn {
  id                String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId      String               @map("store_owner_id") @db.Uuid
  workerId          String?              @map("worker_id") @db.Uuid
  purchaseInvoiceId String               @map("purchase_invoice_id") @db.Uuid
  purchaseItemId    String               @map("purchase_item_id") @db.Uuid
  supplierId        String               @map("supplier_id") @db.Uuid
  itemId            String               @map("item_id") @db.Uuid
  quantity          Decimal              @db.Decimal(12, 3)
  baseQuantity      Decimal              @map("base_quantity") @db.Decimal(12, 3)
  unitPrice         Decimal              @map("unit_price") @db.Decimal(12, 2)
  totalAmount       Decimal              @map("total_amount") @db.Decimal(12, 2)
  refundMethod      PurchaseRefundMethod @map("refund_method")
  reason            String
  returnedAt        DateTime             @default(now()) @map("returned_at")
  createdAt         DateTime             @default(now()) @map("created_at")

  storeOwner      StoreOwner      @relation(fields: [storeOwnerId], references: [id])
  worker          Worker?         @relation(fields: [workerId], references: [id])
  purchaseInvoice PurchaseInvoice @relation(fields: [purchaseInvoiceId], references: [id])
  purchaseItem    PurchaseItem    @relation(fields: [purchaseItemId], references: [id])
  supplier        Supplier        @relation(fields: [supplierId], references: [id])
  item            Item            @relation(fields: [itemId], references: [id])

  @@index([storeOwnerId, purchaseInvoiceId])
  @@index([storeOwnerId, supplierId, returnedAt])
  @@map("purchase_returns")
}

// ═══════════════════════ جاري المالك وتسوية المحافظ الإلكترونية ═══════════════════════

model OwnerTransaction {
  id                 String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId       String               @map("store_owner_id") @db.Uuid
  type               OwnerTransactionType
  amount             Decimal              @db.Decimal(12, 2)
  paymentMethod      PaymentType          @map("payment_method")
  walletId           String?              @map("wallet_id") @db.Uuid
  attachmentUrl      String?              @map("attachment_url")
  note               String?
  walletSettled      Boolean              @default(false) @map("wallet_settled")
  walletSettlementId String?              @map("wallet_settlement_id") @db.Uuid
  transactedAt       DateTime             @default(now()) @map("transacted_at")
  createdAt          DateTime             @default(now()) @map("created_at")

  storeOwner       StoreOwner        @relation(fields: [storeOwnerId], references: [id])
  wallet           Wallet?           @relation(fields: [walletId], references: [id])
  walletSettlement WalletSettlement? @relation(fields: [walletSettlementId], references: [id])

  @@index([storeOwnerId, transactedAt])
  @@index([walletId, walletSettled])
  @@map("owner_transactions")
}

model WalletSettlement {
  id                     String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  storeOwnerId           String                 @map("store_owner_id") @db.Uuid
  walletId               String                 @map("wallet_id") @db.Uuid
  bookBalanceBefore      Decimal                @map("book_balance_before") @db.Decimal(12, 2)
  actualProviderBalance  Decimal                @map("actual_provider_balance") @db.Decimal(12, 2)
  difference             Decimal                @db.Decimal(12, 2)
  cashOutToDrawer        Decimal                @default(0) @map("cash_out_to_drawer") @db.Decimal(12, 2)
  bookBalanceAfter       Decimal                @map("book_balance_after") @db.Decimal(12, 2)
  settledOperationsCount Int                    @default(0) @map("settled_operations_count")
  status                 WalletSettlementStatus @default(MATCHED)
  notes                  String?
  settledAt              DateTime               @default(now()) @map("settled_at")
  createdAt              DateTime               @default(now()) @map("created_at")

  storeOwner         StoreOwner          @relation(fields: [storeOwnerId], references: [id])
  wallet             Wallet              @relation(fields: [walletId], references: [id])
  sales              Sale[]
  creditPayments     CreditPayment[]
  purchaseInvoices   PurchaseInvoice[]
  supplierPayments   SupplierPayment[]
  rentRecords        RentRecord[]
  utilityPayments    UtilityPayment[]
  employeePayments   EmployeePayment[]
  employeeAdvances   EmployeeAdvance[]
  workerAdvances     WorkerAdvance[]
  expenseSettlements ExpenseSettlement[]
  ownerTransactions  OwnerTransaction[]

  @@index([storeOwnerId, walletId, settledAt])
  @@map("wallet_settlements")
}

// ═══════════════════════ المهام الخلفية المجدولة ═══════════════════════

model Job {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  queueName    String    @map("queue_name")
  payload      Json
  status       JobStatus @default(PENDING)
  attempts     Int       @default(0)
  maxAttempts  Int       @default(3) @map("max_attempts")
  runAt        DateTime  @default(now()) @map("run_at")
  lockedAt     DateTime? @map("locked_at")
  lockedBy     String?   @map("locked_by")
  errorMessage String?   @map("error_message")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([queueName, status, runAt])
  @@map("jobs")
}

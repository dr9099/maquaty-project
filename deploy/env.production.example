# نسخ إلى deploy/.env.production واملأ القيم الفعلية — لا يُرفع إلى Git.

# صور GHCR
GHCR_OWNER=your-github-user
IMAGE_TAG=latest

# Caddy / النطاقات
ACME_EMAIL=admin@maqouti.app
API_DOMAIN=api.maqouti.app
ADMIN_DOMAIN=admin.maqouti.app
SITE_DOMAIN=www.maqouti.app
APEX_DOMAIN=maqouti.app

# قاعدة البيانات (PostgreSQL مُدارة)
DATABASE_URL=postgresql://user:pass@host:5432/maqouti?schema=public

# المصادقة
JWT_SECRET=change-me
JWT_ACCESS_TOKEN_TTL=15m
JWT_REFRESH_TOKEN_TTL=30d
ADMIN_JWT_ACCESS_TOKEN_TTL=10m
ADMIN_JWT_REFRESH_TOKEN_TTL=4h
TEMP_PASSWORD_VALIDITY_HOURS=24

# التطبيق
NODE_ENV=production
APP_ENV=production
PORT=3000
LOG_LEVEL=info
TRUST_PROXY=1
CORS_ORIGINS=https://admin.maqouti.app
MIN_SUPPORTED_APP_VERSION=1.0.0

# مراقبة الأخطاء (اختياري)
SENTRY_DSN=

# تخزين الملفات / النسخ (R2/B2)
FILE_STORAGE_PROVIDER=r2
FILE_STORAGE_ENDPOINT=
FILE_STORAGE_REGION=auto
FILE_STORAGE_BUCKET=
FILE_STORAGE_ACCESS_KEY=
FILE_STORAGE_SECRET_KEY=
